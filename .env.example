# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/habittracker?schema=public"

# --- Auth ---
# 32+ character random string
AUTH_SECRET="change-me-to-a-long-random-secret-please-32-chars-min"
ACCESS_TOKEN_TTL="7d"

# --- Frontend ---
# Used by the Next.js frontend to talk to the Express API
NEXT_PUBLIC_API_URL="http://localhost:4000"
# In production set this to https://your-api.vercel.app or your hosted API domain

# --- API (CORS) ---
CORS_ORIGIN="http://localhost:3000"

# --- Environment ---
NODE_ENV="development"

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="100"